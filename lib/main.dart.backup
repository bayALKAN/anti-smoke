              ),
              const SizedBox(height: 30),

              // Ayarlar Listesi
              _profilMenuItem(
                ikon: Icons.note_alt,
                baslik: 'Notlarım',
                aciklama: '${_notlar.length} not',
                onTap: _notlariGoster,
              ),
              _profilMenuItem(
                ikon: Icons.calendar_today,
                baslik: 'Başlangıç Tarihi',
                aciklama: _baslangicTarihi != null
