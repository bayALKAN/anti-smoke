      {'sigaraAdedi': 120, 'ikon': '�', 'isim': 'Ayakkabı', 'aciklama': 'Günlük ayakkabı'},

      // 3-6 aylık hedefler (150-400 sigara = ₺375-₺1000 / 7-20 paket)
      {'sigaraAdedi': 150, 'ikon': '🎧', 'isim': 'Kulaklık', 'aciklama': 'Kaliteli kulaklık'},
