                      ),
                    ),
                  ],
                ),
              ),

              const SizedBox(height: 25),

              // Tasarruf Aktiviteleri
              _tasarrufAktiviteleriKarti(tasarruf),
            ],
          ),
        ),
      ),
    );
  }

  // Profil Sayfası
