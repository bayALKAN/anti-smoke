      {'sigaraAdedi': 400, 'ikon': '🚴', 'isim': 'Bisiklet', 'aciklama': 'Şehir bisikleti'},

      // 6-12 aylık hedefler (500-1200 sigara = ₺1250-₺3000 / 25-60 paket)
