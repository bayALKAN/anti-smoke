  // Bildirimleri kontrol et
  Future<void> _bildirimleriKontrolEt() async {
    if (_baslangicTarihi == null) return;

    final tasarruf = _tasarrufHesapla();

    // Dinamik aktivite listesini al (kullanıcıya özel hesaplanmış)
    final aktiviteler = _dinamikAktiviteler();

    // Yeni ulaşılan hedefleri kontrol et
    for (var aktivite in aktiviteler) {
      final tutar = aktivite['tutar'] as double;
      final bildirimKey = 'aktivite_${aktivite['isim']}';

      // Bu hedefe yeni ulaştık mı?
      if (tasarruf >= tutar && !_gosterilenBildirimler.contains(bildirimKey)) {
        _gosterilenBildirimler.add(bildirimKey);
        await _bildirimGonder(
          aktivite['ikon'] as String,
          aktivite['isim'] as String,
          aktivite['aciklama'] as String,
          tutar,
          aktivite['sigaraAdedi'] as double,
        );
        break; // Bir seferde sadece bir bildirim gönder
      }
    }
  }

  // Bildirim gönder
  // Bildirim gönder
  Future<void> _bildirimGonder(
    String ikon,
    String isim,
    String aciklama,
    double tutar,
    double sigaraAdedi,
  ) async {
    const androidDetails = AndroidNotificationDetails(
      'tasarruf_hedefleri',
      'Tasarruf Hedefleri',
      channelDescription:
          'Yeni tasarruf hedeflerine ulaştığınızda bildirim alın',
      importance: Importance.high,
      priority: Priority.high,
      showWhen: true,
      enableVibration: true,
      playSound: true,
      icon: '@mipmap/ic_launcher',
    );

    const notificationDetails = NotificationDetails(android: androidDetails);

    await flutterLocalNotificationsPlugin.show(
      tutar.toInt(), // Unique ID
      '🎉 Yeni Hedef Açıldı! $ikon',
      'İçilmeyen ${sigaraAdedi.toStringAsFixed(0)} sigara = $isim! (₺${tutar.toStringAsFixed(0)})',
      notificationDetails,
      payload: 'aktivite_$isim',
    );

    // Bildirimi kaydet
    final prefs = await SharedPreferences.getInstance();
    await prefs.setStringList(
      'gosterilen_bildirimler',
      _gosterilenBildirimler.toList(),
    );
  }

  Future<void> _paylasmaYap() async {
    // Başlangıç tarihi kontrolü
    if (_baslangicTarihi == null) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: const Text('Önce başlangıç tarihini ayarlayın!'),
            behavior: SnackBarBehavior.floating,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(10),
            ),
            backgroundColor: Colors.orange,
            action: SnackBarAction(
              label: 'AYARLA',
              textColor: Colors.white,
              onPressed: _baslangicTarihiniAyarla,
            ),
          ),
        );
      }
      return;
    }

    final gecenSure = _gecenSure();
    final gunSayisi = gecenSure.inDays;
    final saat = gecenSure.inHours % 24;
    final dakika = gecenSure.inMinutes % 60;
    final tasarruf = _tasarrufHesapla();
    final icilmeyenSigara = _icilmeyenSigara();

    final mesaj =
        '''
🚭 Sigara Bırakma Başarım 🚭

⏱️ Sigara İçmeden: $gunSayisi gün, $saat saat, $dakika dakika
💰 Tasarruf: ₺${tasarruf.toStringAsFixed(2)}
🚭 İçilmeyen Sigara: $icilmeyenSigara adet
🔥 Streak: $gunSayisi gün üst üste!

💪 Sağlıklı yaşam için ben de sigarayı bıraktım!
#SigarayıBırak #SağlıklıYaşam #Motivasyon
''';

    try {
      await Share.share(mesaj, subject: 'Sigara Bırakma Başarım');
    } catch (e) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Text('Paylaşım hatası: ${e.toString()}'),
            behavior: SnackBarBehavior.floating,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(10),
            ),
            backgroundColor: Colors.red,
            duration: const Duration(seconds: 5),
          ),
        );
      }
    }
  }

  Future<void> _notEkle() async {
    if (_baslangicTarihi == null) {
      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: const Text('Önce başlangıç tarihini ayarlayın!'),
            behavior: SnackBarBehavior.floating,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(10),
            ),
            backgroundColor: Colors.orange,
          ),
        );
      }
      return;
    }

    final TextEditingController notController = TextEditingController();

    final result = await showDialog<String>(
      context: context,
      builder: (context) => AlertDialog(
        title: Row(
          children: [
            const Text('📝', style: TextStyle(fontSize: 24)),
            const SizedBox(width: 8),
            Text(
              'Günlük Not',
              style: GoogleFonts.poppins(
                fontSize: 20,
                fontWeight: FontWeight.bold,
              ),
            ),
          ],
        ),
        content: Column(
          mainAxisSize: MainAxisSize.min,
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Text(
              'Bugün nasıl hissediyorsun?',
              style: GoogleFonts.poppins(
                fontSize: 14,
                color: Theme.of(
                  context,
                ).colorScheme.onSurface.withValues(alpha: 0.7),
              ),
            ),
            const SizedBox(height: 16),
            TextField(
              controller: notController,
              maxLines: 4,
              maxLength: 200,
              decoration: InputDecoration(
                hintText: 'Bugün çok daha iyi hissediyorum...',
                border: OutlineInputBorder(
                  borderRadius: BorderRadius.circular(12),
                ),
                filled: true,
                fillColor: Theme.of(context).colorScheme.surface,
              ),
              autofocus: true,
            ),
          ],
        ),
        shape: RoundedRectangleBorder(borderRadius: BorderRadius.circular(20)),
        actions: [
          TextButton(
            onPressed: () => Navigator.pop(context),
            child: Text(
              'İptal',
              style: GoogleFonts.poppins(
                color: Theme.of(
                  context,
                ).colorScheme.onSurface.withValues(alpha: 0.6),
              ),
            ),
          ),
          FilledButton(
            onPressed: () => Navigator.pop(context, notController.text),
            style: FilledButton.styleFrom(
              backgroundColor: Theme.of(context).colorScheme.primary,
              shape: RoundedRectangleBorder(
                borderRadius: BorderRadius.circular(12),
              ),
            ),
            child: Text(
              'Kaydet',
              style: GoogleFonts.poppins(fontWeight: FontWeight.w600),
            ),
          ),
        ],
      ),
    );

    if (result != null && result.isNotEmpty) {
      final yeniNot = {'tarih': DateTime.now(), 'not': result};

      setState(() {
        _notlar.insert(0, yeniNot);
      });

      // SharedPreferences'a kaydet
      final prefs = await SharedPreferences.getInstance();
      final notlarJson = _notlar.map((not) {
        return '${(not['tarih'] as DateTime).toIso8601String()}|||${not['not']}';
      }).toList();
      await prefs.setStringList('notlar', notlarJson);

      if (mounted) {
        ScaffoldMessenger.of(context).showSnackBar(
          SnackBar(
            content: Row(
              children: [
                const Text('✅', style: TextStyle(fontSize: 18)),
                const SizedBox(width: 8),
                Text(
                  'Notunuz kaydedildi!',
                  style: GoogleFonts.poppins(fontWeight: FontWeight.w600),
                ),
              ],
            ),
            behavior: SnackBarBehavior.floating,
            shape: RoundedRectangleBorder(
              borderRadius: BorderRadius.circular(10),
            ),
            backgroundColor: Colors.green,
            duration: const Duration(seconds: 2),
          ),
        );
      }
    }
  }

