import 'dart:async';
import 'dart:math' as math;
import 'package:flutter/material.dart';
import 'package:flutter_localizations/flutter_localizations.dart';
import 'package:google_fonts/google_fonts.dart';
import 'package:intl/intl.dart';
import 'package:shared_preferences/shared_preferences.dart';
import 'package:share_plus/share_plus.dart';
import 'package:flutter_local_notifications/flutter_local_notifications.dart';

// Global bildirim nesnesi
final FlutterLocalNotificationsPlugin flutterLocalNotificationsPlugin =
    FlutterLocalNotificationsPlugin();

void main() async {
  WidgetsFlutterBinding.ensureInitialized();

  // Bildirim sistemi başlat
  await _bildirimleriBaslat();

  runApp(const SigaraBirakApp());
}

Future<void> _bildirimleriBaslat() async {
  const androidSettings = AndroidInitializationSettings('@mipmap/ic_launcher');
  const initSettings = InitializationSettings(android: androidSettings);

  await flutterLocalNotificationsPlugin.initialize(
    initSettings,
    onDidReceiveNotificationResponse: (details) {
      // Bildirime tıklandığında yapılacaklar
      debugPrint('Bildirim açıldı: ${details.payload}');
    },
  );

  // Android 13+ için bildirim izni iste
  await flutterLocalNotificationsPlugin
      .resolvePlatformSpecificImplementation<
        AndroidFlutterLocalNotificationsPlugin
      >()
      ?.requestNotificationsPermission();
}

class SigaraBirakApp extends StatelessWidget {
  const SigaraBirakApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Sigara Bırak',
      debugShowCheckedModeBanner: false,
      localizationsDelegates: const [
        GlobalMaterialLocalizations.delegate,
        GlobalWidgetsLocalizations.delegate,
        GlobalCupertinoLocalizations.delegate,
      ],
      supportedLocales: const [Locale('tr', 'TR')],
      locale: const Locale('tr', 'TR'),
      theme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF6C63FF),
          brightness: Brightness.light,
        ),
        textTheme: GoogleFonts.poppinsTextTheme(),
      ),
      darkTheme: ThemeData(
        useMaterial3: true,
        colorScheme: ColorScheme.fromSeed(
          seedColor: const Color(0xFF6C63FF),
          brightness: Brightness.dark,
        ),
        textTheme: GoogleFonts.poppinsTextTheme(ThemeData.dark().textTheme),
      ),
      themeMode: ThemeMode.system,
      home: const AnaSayfa(),
    );
  }
}

class AnaSayfa extends StatefulWidget {
  const AnaSayfa({super.key});

  @override
  State<AnaSayfa> createState() => _AnaSayfaState();
}

class _AnaSayfaState extends State<AnaSayfa> {
  DateTime? _baslangicTarihi;
  int _gunlukSigara = 20;
  double _sigaraFiyati = 50.0;
  bool _yuklendi = false;
  int _secilenSayfa = 0;
  List<Map<String, dynamic>> _notlar = [];
  Timer? _timer; // Zamanlayıcı
  Set<String> _gosterilenBildirimler = {}; // Gösterilen bildirimleri takip et

  @override
  void initState() {
    super.initState();
    _verileriYukle();
    // Her saniye ekranı güncelle ve bildirimleri kontrol et
    _timer = Timer.periodic(const Duration(seconds: 1), (timer) {
      if (mounted) {
        setState(() {
          // Sadece UI'ı güncelle
        });
        _bildirimleriKontrolEt(); // Yeni hedeflere ulaşıldı mı kontrol et
      }
    });
  }

  @override
  void dispose() {
    _timer?.cancel(); // Timer'ı temizle
    super.dispose();
  }

  Future<void> _verileriYukle() async {
    final prefs = await SharedPreferences.getInstance();
    final tarihStr = prefs.getString('baslangic_tarihi');
    final notlarJson = prefs.getStringList('notlar') ?? [];
    final bildirimlerJson = prefs.getStringList('gosterilen_bildirimler') ?? [];

    setState(() {
      if (tarihStr != null) {
        _baslangicTarihi = DateTime.parse(tarihStr);
      }
      _gunlukSigara = prefs.getInt('gunluk_sigara') ?? 20;
      _sigaraFiyati = prefs.getDouble('sigara_fiyati') ?? 50.0;

      // Notları yükle
      _notlar = notlarJson.map((notJson) {
        final parts = notJson.split('|||');
        return {'tarih': DateTime.parse(parts[0]), 'not': parts[1]};
      }).toList();

      // Gösterilen bildirimleri yükle
      _gosterilenBildirimler = Set<String>.from(bildirimlerJson);

      _yuklendi = true;
    });
  }

  Future<void> _baslangicTarihiniAyarla() async {
    final tarih = await showDatePicker(
      context: context,
      initialDate: DateTime.now(),
      firstDate: DateTime(2020),
      lastDate: DateTime.now(),
      helpText: 'Sigarayı bıraktığınız tarihi seçin',
    );

    if (tarih != null) {
      final prefs = await SharedPreferences.getInstance();
      await prefs.setString('baslangic_tarihi', tarih.toIso8601String());
      setState(() {
        _baslangicTarihi = tarih;
      });
    }
  }

  Duration _gecenSure() {
    if (_baslangicTarihi == null) return Duration.zero;
    return DateTime.now().difference(_baslangicTarihi!);
  }

  double _tasarrufHesapla() {
    final gecenSure = _gecenSure();
    final toplamSaat = gecenSure.inHours + (gecenSure.inMinutes % 60) / 60.0;
    final saatteIcilenSigara =
        _gunlukSigara / 24.0; // Saatte kaç sigara içiliyor
    final icilmeyenSigara = toplamSaat * saatteIcilenSigara; // Toplam içilmeyen
    final paketFiyati = _sigaraFiyati; // Paket fiyatı
    final sigaraBasinaFiyat = paketFiyati / 20.0; // Bir sigara fiyatı
    return icilmeyenSigara * sigaraBasinaFiyat;
  }

  int _icilmeyenSigara() {
    final gecenSure = _gecenSure();
    final toplamSaat = gecenSure.inHours + (gecenSure.inMinutes % 60) / 60.0;
    final saatteIcilenSigara = _gunlukSigara / 24.0; // Saatte kaç sigara
    return (toplamSaat * saatteIcilenSigara).floor(); // Tam sayıya yuvarla
  }

