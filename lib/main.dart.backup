  Widget _kompaktZamanKutusu(
    String deger,
    String etiket, [
    bool kompakt = false,
  ]) {
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 600),
      builder: (context, value, child) {
        return Opacity(
          opacity: value,
          child: Transform.scale(scale: 0.8 + (value * 0.2), child: child),
        );
      },
      child: Column(
        mainAxisSize: MainAxisSize.min,
        children: [
          Text(
            deger,
            style: GoogleFonts.poppins(
              fontSize: kompakt ? 28 : 32,
              fontWeight: FontWeight.bold,
              color: Colors.white,
              height: 1,
            ),
          ),
          if (!kompakt) const SizedBox(height: 4),
          Text(
            etiket,
            style: GoogleFonts.poppins(
              fontSize: kompakt ? 9 : 11,
              color: Colors.white.withValues(alpha: 0.8),
              fontWeight: FontWeight.w500,
              letterSpacing: kompakt ? 0.5 : 1,
            ),
          ),
        ],
      ),
    );
  }

  Widget _hizliEylemButon(
    String emoji,
    String baslik,
    Color renk, [
    VoidCallback? onTap,
  ]) {
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 500),
      builder: (context, value, child) {
        return Transform.scale(
          scale: 0.8 + (value * 0.2),
          child: Opacity(opacity: value, child: child),
        );
      },
      child: Material(
        color: Colors.transparent,
        child: InkWell(
          onTap:
              onTap ??
              () {
                ScaffoldMessenger.of(context).showSnackBar(
                  SnackBar(
                    content: Text('$baslik özelliği yakında!'),
                    behavior: SnackBarBehavior.floating,
                    shape: RoundedRectangleBorder(
                      borderRadius: BorderRadius.circular(10),
                    ),
                    duration: const Duration(seconds: 2),
                  ),
                );
              },
          borderRadius: BorderRadius.circular(16),
          child: Container(
            padding: const EdgeInsets.symmetric(vertical: 14),
            decoration: BoxDecoration(
              color: Theme.of(context).colorScheme.surface,
              borderRadius: BorderRadius.circular(16),
              border: Border.all(color: renk.withValues(alpha: 0.3), width: 2),
              boxShadow: [
                BoxShadow(
                  color: renk.withValues(alpha: 0.1),
                  blurRadius: 8,
                  offset: const Offset(0, 4),
                ),
              ],
            ),
            child: Column(
              children: [
                Text(emoji, style: const TextStyle(fontSize: 24)),
                const SizedBox(height: 4),
                Text(
                  baslik,
                  style: GoogleFonts.poppins(
                    fontSize: 11,
                    fontWeight: FontWeight.w600,
                    color: renk,
                  ),
                ),
              ],
            ),
          ),
        ),
      ),
    );
  }

  Widget _animasyonluIstatistikKart({
    required String ikon,
    required String baslik,
    required double deger,
    required String birim,
    required List<Color> gradient,
  }) {
    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: deger),
      duration: const Duration(milliseconds: 1500),
      curve: Curves.easeOutCubic,
      builder: (context, animatedValue, child) {
        return TweenAnimationBuilder<double>(
          tween: Tween(begin: 0.0, end: 1.0),
          duration: const Duration(milliseconds: 500),
          builder: (context, scaleValue, _) {
            return Transform.scale(
              scale: 0.9 + (scaleValue * 0.1),
              child: Container(
                padding: const EdgeInsets.all(18),
                decoration: BoxDecoration(
                  gradient: LinearGradient(
                    begin: Alignment.topLeft,
                    end: Alignment.bottomRight,
                    colors: gradient,
                  ),
                  borderRadius: BorderRadius.circular(20),
                  boxShadow: [
                    BoxShadow(
                      color: gradient[0].withValues(alpha: 0.4),
                      blurRadius: 15,
                      offset: const Offset(0, 8),
                    ),
                  ],
                ),
                child: Column(
                  crossAxisAlignment: CrossAxisAlignment.start,
                  children: [
                    Row(
                      children: [
                        Text(ikon, style: const TextStyle(fontSize: 28)),
                        const Spacer(),
                        // Pulse Animation
                        TweenAnimationBuilder<double>(
                          tween: Tween(begin: 1.0, end: 1.2),
                          duration: const Duration(milliseconds: 800),
                          curve: Curves.easeInOut,
                          builder: (context, pulseValue, child) {
                            return Transform.scale(
                              scale: pulseValue,
                              child: Container(
                                padding: const EdgeInsets.all(6),
                                decoration: BoxDecoration(
                                  color: Colors.white.withValues(alpha: 0.3),
                                  shape: BoxShape.circle,
                                ),
                                child: const Icon(
                                  Icons.trending_up,
                                  color: Colors.white,
                                  size: 16,
                                ),
                              ),
                            );
                          },
                        ),
                      ],
                    ),
                    const SizedBox(height: 12),
                    Text(
                      baslik,
                      style: GoogleFonts.poppins(
                        fontSize: 12,
                        color: Colors.white.withValues(alpha: 0.9),
                        fontWeight: FontWeight.w500,
                      ),
                    ),
                    const SizedBox(height: 4),
                    Text(
                      '$birim${animatedValue.toStringAsFixed(0)}',
                      style: GoogleFonts.poppins(
                        fontSize: 24,
                        fontWeight: FontWeight.bold,
                        color: Colors.white,
                      ),
                    ),
                  ],
                ),
              ),
            );
          },
        );
      },
    );
  }

  Widget _miniGrafikKarti(int gunSayisi) {
    // Saat bazlı hassas hesaplama için
    final gecenSure = _gecenSure();
    final toplamSaat = gecenSure.inHours + (gecenSure.inMinutes % 60) / 60.0;
    final toplamGun = toplamSaat / 24.0; // Kesirli gün sayısı (0.5, 1.2, vb.)

    // Son 7 günün gerçekçi motivasyon trendi
    final List<double> trendData = List.generate(7, (index) {
      // Her gün için motivasyon puanı (50-85 arası)
      double baseScore = 50.0;

      // Geçen gün sayısına göre ilerleme
      if (toplamGun < 1) {
        // İlk 24 saat: Sadece bugün için ilerleme göster
        if (index == 6) {
          // Son çubuk (bugün) - saatlere göre dolsun
          return (50 + (toplamSaat / 24.0) * 15).clamp(50.0, 65.0);
        } else {
          // Diğer günler boş
          return 20.0; // Minimum boy
        }
      } else {
        // 1 günden fazla: Her gün kademeli artış
        double dayProgress;
        if (index < toplamGun.ceil()) {
          // Geçmiş günler: Tam dolu
          dayProgress = (index + 1) * 3.5;
        } else if (index == toplamGun.floor()) {
          // Bugün: Saatlere göre kısmi dolu
          double todayProgress = (toplamGun - toplamGun.floor()) * 3.5;
          dayProgress = (index + 1) * 3.5 + todayProgress;
        } else {
          // Gelecek günler: Minimum
          return 20.0;
        }

        // Toplam süreye göre bonus
        double totalBonus = (toplamGun / 30).clamp(0.0, 3.0) * (index + 1);
        return (baseScore + dayProgress + totalBonus).clamp(50.0, 85.0);
      }
    });

    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 700),
      builder: (context, value, child) {
        return Opacity(
          opacity: value,
          child: Transform.translate(
            offset: Offset(0, 20 * (1 - value)),
            child: child,
          ),
        );
      },
      child: Container(
        padding: const EdgeInsets.all(18),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: [Colors.purple.shade400, Colors.deepPurple.shade600],
          ),
          borderRadius: BorderRadius.circular(20),
          boxShadow: [
            BoxShadow(
              color: Colors.purple.withValues(alpha: 0.3),
              blurRadius: 15,
              offset: const Offset(0, 8),
            ),
          ],
        ),
        child: Column(
          crossAxisAlignment: CrossAxisAlignment.start,
          children: [
            Row(
              children: [
                const Text('📈', style: TextStyle(fontSize: 24)),
                const SizedBox(width: 8),
                Text(
                  '7 Günlük İlerleme',
                  style: GoogleFonts.poppins(
                    fontSize: 14,
                    fontWeight: FontWeight.w600,
                    color: Colors.white,
                  ),
                ),
                const Spacer(),
                Container(
                  padding: const EdgeInsets.symmetric(
                    horizontal: 8,
                    vertical: 4,
                  ),
                  decoration: BoxDecoration(
                    color: Colors.white.withValues(alpha: 0.2),
                    borderRadius: BorderRadius.circular(12),
                  ),
                  child: Row(
                    children: [
                      const Icon(
                        Icons.arrow_upward,
                        color: Colors.white,
                        size: 12,
                      ),
                      const SizedBox(width: 2),
                      Text(
                        // Gerçekçi yüzde hesabı - sadece dolu günleri kullan
                        toplamGun < 1
                            ? '+${(toplamSaat / 24.0 * 100).toStringAsFixed(0)}%' // İlk gün: tamamlanma yüzdesi
                            : toplamGun < 7
                            ? '+${(toplamGun / 7.0 * 100).toStringAsFixed(0)}%' // 1-6 gün: haftalık ilerleme
                            : '+100%', // 7+ gün: tam tamamlanmış
                        style: GoogleFonts.poppins(
                          fontSize: 11,
                          fontWeight: FontWeight.bold,
                          color: Colors.white,
                        ),
                      ),
                    ],
                  ),
                ),
              ],
            ),
            const SizedBox(height: 15),
            // Mini Sparkline
            SizedBox(
              height: 70,
              child: Row(
                crossAxisAlignment: CrossAxisAlignment.end,
                mainAxisAlignment: MainAxisAlignment.spaceEvenly,
                children: List.generate(7, (index) {
                  final maxHeight = trendData.reduce(math.max);
                  final barHeight = (trendData[index] / maxHeight) * 50;

                  return TweenAnimationBuilder<double>(
                    tween: Tween(begin: 0.0, end: barHeight),
                    duration: Duration(milliseconds: 500 + (index * 100)),
                    curve: Curves.easeOutCubic,
                    builder: (context, animValue, child) {
                      return Expanded(
                        child: Padding(
                          padding: const EdgeInsets.symmetric(horizontal: 2),
                          child: Column(
                            mainAxisAlignment: MainAxisAlignment.end,
                            mainAxisSize: MainAxisSize.min,
                            children: [
                              Container(
                                width: double.infinity,
                                height: animValue,
                                decoration: BoxDecoration(
                                  color: index == 6
                                      ? Colors.white
                                      : Colors.white.withValues(alpha: 0.5),
                                  borderRadius: BorderRadius.circular(4),
                                ),
                              ),
                              const SizedBox(height: 6),
                              Text(
                                [
                                  'Pzt',
                                  'Sal',
                                  'Çar',
                                  'Per',
                                  'Cum',
                                  'Cmt',
                                  'Paz',
                                ][index],
                                style: GoogleFonts.poppins(
                                  fontSize: 7.5,
                                  color: Colors.white.withValues(alpha: 0.7),
                                  fontWeight: FontWeight.w500,
                                ),
                                maxLines: 1,
                                overflow: TextOverflow.clip,
                              ),
                            ],
                          ),
                        ),
                      );
                    },
                  );
                }),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _canliSaglikGostergesi(Duration gecenSure) {
    // Daha hassas hesaplama - saat bazında
    final toplamSaat = gecenSure.inHours + (gecenSure.inMinutes % 60) / 60.0;
    final toplamGun = toplamSaat / 24.0;

    // Akciğer iyileşmesi: 15 yılda tam iyileşme (5475 gün)
    // İlk 1 yılda %30, sonrasında yavaşlayarak %100'e ulaşır
    double akcigerSagligi;
    if (toplamGun < 365) {
      // İlk yıl: %0-30 arası (hızlı iyileşme)
      akcigerSagligi = (toplamGun / 365) * 0.30;
    } else {
      // Sonraki 14 yıl: %30-100 arası (yavaş iyileşme)
      final kalanGun = toplamGun - 365;
      final kalanIyilesme = (kalanGun / (14 * 365)) * 0.70;
      akcigerSagligi = 0.30 + kalanIyilesme;
    }
    akcigerSagligi = akcigerSagligi.clamp(0.0, 1.0);

    // Oksijen seviyesi: İlk 20 dakikada bile artmaya başlar
    // Normal sigara içmeyen: 95-100%
    // Sigara içen: 92-95%
    // İyileşme sürecinde: 92% -> 98%
    double oksijenSeviyesi = 92 + (akcigerSagligi * 6); // 92-98% arası

    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 800),
      builder: (context, value, child) {
        return Opacity(
          opacity: value,
          child: Transform.translate(
            offset: Offset(0, 20 * (1 - value)),
            child: child,
          ),
        );
      },
      child: Container(
        padding: const EdgeInsets.all(18),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: [Colors.teal.shade400, Colors.green.shade600],
          ),
          borderRadius: BorderRadius.circular(20),
          boxShadow: [
            BoxShadow(
              color: Colors.teal.withValues(alpha: 0.3),
              blurRadius: 15,
              offset: const Offset(0, 8),
            ),
          ],
        ),
        child: Row(
          children: [
            // Akciğer İkonu with Pulse
            TweenAnimationBuilder<double>(
              tween: Tween(begin: 0.95, end: 1.05),
              duration: const Duration(milliseconds: 1000),
              curve: Curves.easeInOut,
              builder: (context, pulseValue, child) {
                return Transform.scale(
                  scale: pulseValue,
                  child: Container(
                    padding: const EdgeInsets.all(16),
                    decoration: BoxDecoration(
                      color: Colors.white.withValues(alpha: 0.2),
                      borderRadius: BorderRadius.circular(16),
                    ),
                    child: Text(
                      '🫁',
                      style: TextStyle(
                        fontSize: 40,
                        color: Color.lerp(
                          Colors.red,
                          Colors.green,
                          akcigerSagligi,
                        ),
                      ),
                    ),
                  ),
                );
              },
            ),
            const SizedBox(width: 15),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Akciğer Sağlığı',
                    style: GoogleFonts.poppins(
                      fontSize: 13,
                      color: Colors.white.withValues(alpha: 0.9),
                      fontWeight: FontWeight.w500,
                    ),
                  ),
                  const SizedBox(height: 8),
                  // Progress Bar
                  TweenAnimationBuilder<double>(
                    tween: Tween(begin: 0.0, end: akcigerSagligi),
                    duration: const Duration(milliseconds: 1500),
                    curve: Curves.easeOutCubic,
                    builder: (context, animValue, child) {
                      return Column(
                        crossAxisAlignment: CrossAxisAlignment.start,
                        children: [
                          ClipRRect(
                            borderRadius: BorderRadius.circular(10),
                            child: LinearProgressIndicator(
                              value: animValue,
                              backgroundColor: Colors.white.withValues(
                                alpha: 0.3,
                              ),
                              valueColor: const AlwaysStoppedAnimation<Color>(
                                Colors.white,
                              ),
                              minHeight: 8,
                            ),
                          ),
                          const SizedBox(height: 6),
                          Row(
                            children: [
                              Text(
                                // İlk günlerde daha hassas gösterim
                                toplamGun < 30
                                    ? 'İyileşme: %${(animValue * 100).toStringAsFixed(2)}' // İki ondalık
                                    : 'İyileşme: %${(animValue * 100).toStringAsFixed(0)}', // Tam sayı
                                style: GoogleFonts.poppins(
                                  fontSize: 11,
                                  fontWeight: FontWeight.w600,
                                  color: Colors.white,
                                ),
                              ),
                              const Spacer(),
                              Container(
                                padding: const EdgeInsets.symmetric(
                                  horizontal: 8,
                                  vertical: 2,
                                ),
                                decoration: BoxDecoration(
                                  color: Colors.white.withValues(alpha: 0.2),
                                  borderRadius: BorderRadius.circular(8),
                                ),
                                child: Row(
                                  children: [
                                    const Text(
                                      '❤️',
                                      style: TextStyle(fontSize: 10),
                                    ),
                                    const SizedBox(width: 4),
                                    Text(
                                      '${oksijenSeviyesi.toStringAsFixed(0)}%',
                                      style: GoogleFonts.poppins(
                                        fontSize: 10,
                                        fontWeight: FontWeight.bold,
                                        color: Colors.white,
                                      ),
                                    ),
                                  ],
                                ),
                              ),
                            ],
                          ),
                        ],
                      );
                    },
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _kompaktSaglikKarti(Duration gecenSure) {
    final saatler = gecenSure.inHours;
    String mesaj;
    String ikon;
    List<Color> gradient;

    if (saatler < 1) {
      mesaj = '20 dakika içinde kalp atışınız normale dönecek!';
      ikon = '❤️';
      gradient = [Colors.red.shade400, Colors.pink.shade600];
    } else if (saatler < 24) {
      mesaj = '12 saat içinde kan CO seviyeniz normale dönecek!';
      ikon = '🫁';
      gradient = [Colors.blue.shade400, Colors.cyan.shade600];
    } else if (saatler < 48) {
      mesaj = '24 saat içinde kalp krizi riskiniz azalacak!';
      ikon = '💪';
      gradient = [Colors.pink.shade400, Colors.red.shade600];
    } else if (saatler < 72) {
      mesaj = '48 saat içinde sinir uçları yenilenmeye başlayacak!';
      ikon = '🧠';
      gradient = [Colors.purple.shade400, Colors.deepPurple.shade600];
    } else {
      mesaj = 'Harika! Vücudunuz her geçen gün iyileşiyor!';
      ikon = '🎉';
      gradient = [Colors.orange.shade400, Colors.deepOrange.shade600];
    }

    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 600),
      builder: (context, value, child) {
        return Transform.translate(
          offset: Offset(0, 20 * (1 - value)),
          child: Opacity(opacity: value, child: child),
        );
      },
      child: Container(
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: gradient,
          ),
          borderRadius: BorderRadius.circular(20),
          boxShadow: [
            BoxShadow(
              color: gradient[0].withValues(alpha: 0.4),
              blurRadius: 15,
              offset: const Offset(0, 8),
            ),
          ],
        ),
        child: Row(
          children: [
            Text(ikon, style: const TextStyle(fontSize: 48)),
            const SizedBox(width: 16),
            Expanded(
              child: Column(
                crossAxisAlignment: CrossAxisAlignment.start,
                children: [
                  Text(
                    'Sağlık İyileşmesi',
                    style: GoogleFonts.poppins(
                      fontSize: 13,
                      fontWeight: FontWeight.w600,
                      color: Colors.white.withValues(alpha: 0.9),
                    ),
                  ),
                  const SizedBox(height: 4),
                  Text(
                    mesaj,
                    style: GoogleFonts.poppins(
                      fontSize: 14,
                      color: Colors.white,
                      fontWeight: FontWeight.w500,
                      height: 1.3,
                    ),
                  ),
                ],
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _kompaktMotivasyonKarti(int gunSayisi) {
    String mesaj;
    String ikon;

    if (gunSayisi == 0) {
      mesaj = 'Harika bir başlangıç! İlk adımı attınız!';
      ikon = '🚀';
    } else if (gunSayisi < 7) {
      mesaj = 'İlk hafta! Devam edin, harikasınız!';
      ikon = '⭐';
    } else if (gunSayisi < 30) {
      mesaj = 'İnanılmaz! $gunSayisi gün sigara içmediniz!';
      ikon = '🏆';
    } else {
      mesaj = 'MUHTEŞEM! ${(gunSayisi / 30).floor()} ay tamamladınız!';
      ikon = '👑';
    }

    return TweenAnimationBuilder<double>(
      tween: Tween(begin: 0.0, end: 1.0),
      duration: const Duration(milliseconds: 700),
      builder: (context, value, child) {
        return Transform.scale(
          scale: 0.9 + (value * 0.1),
          child: Opacity(opacity: value, child: child),
        );
      },
      child: Container(
        padding: const EdgeInsets.all(20),
        decoration: BoxDecoration(
          gradient: LinearGradient(
            begin: Alignment.topLeft,
            end: Alignment.bottomRight,
            colors: [
              Theme.of(context).colorScheme.tertiaryContainer,
              Theme.of(context).colorScheme.primaryContainer,
            ],
          ),
          borderRadius: BorderRadius.circular(20),
          border: Border.all(
            color: Theme.of(context).colorScheme.primary.withValues(alpha: 0.3),
            width: 2,
          ),
        ),
        child: Row(
          children: [
            Text(ikon, style: const TextStyle(fontSize: 40)),
            const SizedBox(width: 16),
            Expanded(
              child: Text(
                mesaj,
                style: GoogleFonts.poppins(
                  fontSize: 15,
                  fontWeight: FontWeight.bold,
                  color: Theme.of(context).colorScheme.onTertiaryContainer,
                  height: 1.3,
                ),
              ),
            ),
          ],
        ),
      ),
    );
  }

  // İstatistikler Sayfası
